@page "/login"
@using Microsoft.AspNetCore.Components.Authorization
@using System.ComponentModel.DataAnnotations
@using WebChat.Services
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Logga in - WebChat</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h2><i class="bi bi-shield-lock"></i>Isa Inloggning</h2>
            <p class="text-muted">Ange lösenordet för att komma åt Isa</p>
        </div>

        <div class="login-form">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-triangle"></i> @errorMessage
                </div>
            }

            <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label for="password" class="form-label">Lösenord</label>
                    <div class="input-group">
                        <span class="input-group-text login-input-group-text"><i class="bi bi-key"></i></span>
                        <InputText @bind-Value="loginModel.Password" type="password"
                            class="form-control login-form-control" id="password" placeholder="Ange lösenord" />
                    </div>
                    <ValidationMessage For="() => loginModel.Password" />
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg login-btn-primary" disabled="@isLoggingIn">
                        @if (isLoggingIn)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Loggar in...</span>
                        }
                        else
                        {
                            <i class="bi bi-box-arrow-in-right me-2"></i>
                            <span>Logga in</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<link rel="stylesheet" href="css/login-v3.css" />

@code {
    private LoginModel loginModel = new();
    private string errorMessage = string.Empty;
    private bool isLoggingIn = false;

    protected override async Task OnInitializedAsync()
    {
        // Kolla OAuth-parametrar
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        if (query["oauth"] == "fortnox" && query["success"] == "true")
        {
            // OAuth lyckades - automatisk inloggning eller visa meddelande
            await HandleOAuthSuccess();
            return;
        }

        // Check if user is already authenticated
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task HandleLogin()
    {
        isLoggingIn = true;
        errorMessage = string.Empty;

        try
        {
            var configuredPassword = Configuration["WebChat:Password"] ?? "isa72";

            if (loginModel.Password == configuredPassword)
            {
                // Mark user as authenticated
                var sessionProvider = (SessionAuthenticationStateProvider)AuthenticationStateProvider;
                await sessionProvider.MarkUserAsAuthenticated();
                
                // Navigate to the main page (smooth transition)
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = "Felaktigt lösenord. Försök igen.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Inloggning misslyckades: {ex.Message}";
        }
        finally
        {
            isLoggingIn = false;
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Lösenord krävs")]
        public string Password { get; set; } = string.Empty;
    }

    private async Task HandleOAuthSuccess()
    {
        // Automatiskt logga in användaren efter OAuth
        var sessionProvider = (SessionAuthenticationStateProvider)AuthenticationStateProvider;
        await sessionProvider.MarkUserAsAuthenticated();

        // Visa meddelande och redirect (smooth transition)
        await JSRuntime.InvokeVoidAsync("alert", "Fortnox OAuth lyckades! Du är nu inloggad.");
        Navigation.NavigateTo("/");
    }
}
