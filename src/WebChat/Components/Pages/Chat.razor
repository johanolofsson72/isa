    // Check if message contains file import command
    private bool IsFileImportCommand(string message)
    {
        var lowerMessage = message.ToLowerInvariant();

        // Swedish variants
        if (lowerMessage.Contains("importera") && (lowerMessage.Contains("faktura") || lowerMessage.Contains("fil")))
            return true;

        if (lowerMessage.Contains("behandla") && lowerMessage.Contains("fil"))
            return true;

        if (lowerMessage.Contains("ladda") && lowerMessage.Contains("faktura") && lowerMessage.Contains("fortnox"))
            return true;

        // Document interpretation commands
        if ((lowerMessage.Contains("tolka") || lowerMessage.Contains("kolla") || lowerMessage.Contains("undersök")) &&
            (lowerMessage.Contains("fil") || lowerMessage.Contains("dokument")))
            return true;

        // English variants
        if (lowerMessage.Contains("import") && (lowerMessage.Contains("invoice") || lowerMessage.Contains("file")))
            return true;

        if (lowerMessage.Contains("process") && lowerMessage.Contains("file"))
            return true;

        if ((lowerMessage.Contains("interpret") || lowerMessage.Contains("analyze")) &&
            (lowerMessage.Contains("file") || lowerMessage.Contains("document")))
            return true;

        return false;
    }

    // Handle file import workflow
    private async Task HandleFileImportAsync(string originalMessage)
    {
        if (string.IsNullOrEmpty(currentSessionId) || !sessionFiles.Any())
        {
            isTyping = false;
            AddMessage("❌ System", "Inga filer att importera", false);
            StateHasChanged();
            return;
        }

        try
        {
            // Get the first file (as per requirement: "take the file regardless of name")
            var fileToImport = sessionFiles.First();

            AddMessage("🔄 System", $"Startar import av {fileToImport.FileName}...", false);
            StateHasChanged();

            // Step 1: Create FileRecord for the Agent
            var fileRecord = new FileRecord
            {
                Id = Guid.Parse(fileToImport.FileId),
                FileName = fileToImport.FileName,
                FilePath = fileToImport.FilePath,
                ContentType = fileToImport.ContentType,
                FileSize = fileToImport.FileSize,
                Source = "WebChat Upload",
                SourcePath = fileToImport.FileName,
                CreatedAt = fileToImport.UploadedAt
            };

            // Step 2: Send to Agent for document processing
            AddMessage("📄 System", "Skickar till dokumenttolk...", false);
            StateHasChanged();

            var agentClient = HttpClientFactory.CreateClient("agent");
            var json = JsonSerializer.Serialize(fileRecord);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");

            var processResponse = await agentClient.PostAsync("/api/documents/process", content);
            
            if (!processResponse.IsSuccessStatusCode)
            {
                throw new Exception($"Document processing failed: {processResponse.StatusCode}");
            }

            var processResult = await processResponse.Content.ReadAsStringAsync();
            Logger.LogInformation("Document processing started: {Result}", processResult);

            // Step 3: Wait for processing to complete and get results
            AddMessage("⏳ System", "Väntar på dokumentanalys...", false);
            StateHasChanged();

            await Task.Delay(3000); // Give time for processing

            var analysisResponse = await agentClient.GetAsync($"/api/documents/analysis/{fileToImport.FileId}");
            
            if (analysisResponse.IsSuccessStatusCode)
            {
                var analysisResult = await analysisResponse.Content.ReadAsStringAsync();
                Logger.LogInformation("Document analysis completed: {Result}", analysisResult);

                // Step 4: Send analysis result to regular chat for Fortnox processing
                AddMessage("💼 System", "Dokumentanalys klar, skickar till Fortnox...", false);
                StateHasChanged();

                // Send the analysis to the chat system with Fortnox instruction
                var fortnoxInstruction = $"Här är resultatet från dokumentanalys av {fileToImport.FileName}. Skapa leverantörsfaktura i Fortnox med denna information: {analysisResult}";
                
                if (chatService is not null)
                {
                    await chatService.SendMessageAsync(fortnoxInstruction);
                }

                // Step 5: Remove the file on success
                await SessionFileService.DeleteFileAsync(currentSessionId, fileToImport.FileId);
                await LoadSessionFiles();

                isTyping = false;
                AddMessage("✅ System", $"Import av {fileToImport.FileName} slutförd och fil raderad automatiskt", false);
                StateHasChanged();
            }
            else
            {
                throw new Exception("Document analysis not ready or failed");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during file import");
            isTyping = false;
            AddMessage("❌ System", $"Import misslyckades: {ex.Message}. Filen behålls för manuell hantering.", false);
            StateHasChanged();
        }
    }


