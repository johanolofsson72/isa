{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AnalysisPlugin.Services.ExternalAnalysisService": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ExternalAPIs": {
    "OpenAI": {
      "BaseUrl": "https://api.openai.com/v1",
      "Model": "gpt-4",
      "MaxTokens": 1000,
      "Temperature": 0.7,
      "Enabled": false
    },
    "SCB": {
      "BaseUrl": "https://api.scb.se/OV0104/v1/doris/sv/ssd",
      "TimeoutSeconds": 30,
      "Enabled": true,
      "DefaultIndicators": [
        "START/PR/PR0101/PR0101E/BasbeloppTidsserie",
        "START/NR/NR0103/NR0103A/NR0103ENS2010T03Ar",
        "START/AM/AM0207/AM0207A/AM0207C02"
      ]
    },
    "Riksbank": {
      "BaseUrl": "https://api.riksbank.se/swea/v1",
      "TimeoutSeconds": 30,
      "Enabled": true,
      "DefaultSeries": [
        "SEKEURPMI",
        "SEKUSDPMI",
        "REPORÄNTA"
      ]
    },
    "YahooFinance": {
      "BaseUrl": "https://query1.finance.yahoo.com/v8/finance",
      "TimeoutSeconds": 30,
      "Enabled": true,
      "DefaultSymbols": [
        "^OMX",
        "OMXSPI.ST",
        "SEK=X"
      ]
    },
    "General": {
      "CacheExpirationMinutes": 60,
      "MaxRetryAttempts": 3,
      "CircuitBreakerThreshold": 5,
      "CircuitBreakerTimeoutMinutes": 5,
      "EnableFallbackData": true,
      "LogApiCalls": true
    }
  }
}
