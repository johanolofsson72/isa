    // Job History and Monitoring Methods
    private async Task LoadJobHistory()
    {
        if (selectedWorkflow == null) return;

        isLoadingHistory = true;
        try
        {
            var response = await Http.GetAsync($"https://localhost:7042/api/JobHistory/executions?workflowId={selectedWorkflow.Id}&pageSize=20");
            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                var executions = System.Text.Json.JsonSerializer.Deserialize<List<JobExecutionRecord>>(content, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });
                jobExecutions = executions ?? new List<JobExecutionRecord>();
            }
        }
        catch (Exception ex)
        {
            await SafeJSError($"Error loading job history: {ex.Message}");
        }
        finally
        {
            isLoadingHistory = false;
            await InvokeAsync(StateHasChanged);
        }
    }

