    /// <summary>
    /// Safely invoke JavaScript without causing JSInterop errors
    /// </summary>
    private async Task SafeInvokeJSAsync(string identifier, params object[] args)
    {
        try
        {
            await Task.Delay(100); // Small delay to ensure DOM is ready
            await JS.InvokeVoidAsync(identifier, args);
        }
        catch (JSDisconnectedException)
        {
            Logger.LogDebug("JSInterop call skipped - circuit disconnected: {Identifier}", identifier);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "JSInterop call failed: {Identifier}", identifier);
        }
    }

    /// <summary>
    /// Safely invoke JavaScript with return value without causing JSInterop errors
    /// </summary>
    private async Task<T> SafeInvokeJSAsync<T>(string identifier, params object[] args)
    {
        try
        {
            await Task.Delay(100); // Small delay to ensure DOM is ready
            return await JS.InvokeAsync<T>(identifier, args);
        }
        catch (JSException ex)
        {
            Logger.LogWarning("JavaScript call failed: {Error}", ex.Message);
            return default(T)!;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error during JavaScript call");
            return default(T)!;
        }
    }

