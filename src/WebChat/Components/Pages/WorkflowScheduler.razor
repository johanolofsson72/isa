                    IsQuartzManaged = false,
                    Status = "Test",
                    SuccessRate = 95.5,
                    TotalExecutions = 42,
                    AverageExecutionTime = "00:02:15"
                });
            }
        }
        catch (Exception ex)
        {
            await SafeJSError($"LoadSchedules error: {ex.Message}");
            await SafeJSError(ex.StackTrace ?? "No stack trace available");
            schedules = new List<WorkflowScheduleInfo>();
        }

        // Ensure UI is updated
        await InvokeAsync(StateHasChanged);
    }

    private async Task<List<WorkflowScheduleInfo>?> LoadQuartzSchedules()
    {
        try
        {
            await SafeJSLog("LoadQuartzSchedules: Loading from Quartz.NET API...");

            // Call the new Quartz.NET monitoring API
            var response = await Http.GetAsync("https://localhost:7042/api/monitoring/metrics");
            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                var metricsData = JsonSerializer.Deserialize<Dictionary<string, QuartzWorkflowMetrics>>(content, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

                if (metricsData != null)
                {
                    var quartzSchedules = new List<WorkflowScheduleInfo>();

                    foreach (var kvp in metricsData)
                    {
                        var metrics = kvp.Value;
                        quartzSchedules.Add(new WorkflowScheduleInfo
                        {
                            Id = metrics.WorkflowId,
                            Name = metrics.WorkflowName,
                            Description = $"Quartz.NET managed workflow - {metrics.TotalExecutions} executions",
                            Schedule = "Managed by Quartz.NET", // We'd need additional API call to get actual schedule
                            Enabled = true,
                            LastExecuted = metrics.LastExecutionTime,
                            NextExecutionTime = null, // Would need additional API call
                            IsQuartzManaged = true,
                            SuccessRate = metrics.SuccessRate,
                            TotalExecutions = metrics.TotalExecutions,
                            AverageExecutionTime = metrics.AverageExecutionTime,
                            ConsecutiveFailures = metrics.ConsecutiveFailures
                        });
                    }

                    await SafeJSLog($"LoadQuartzSchedules: Loaded {quartzSchedules.Count} Quartz workflows");
                    return quartzSchedules;
                }
            }
            else
            {
                await SafeJSLog($"LoadQuartzSchedules: API call failed with status {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            await SafeJSError($"LoadQuartzSchedules error: {ex.Message}");
        }

        return null;
    }

    private async Task TriggerWorkflowNow(WorkflowScheduleInfo workflow)
    {
        try
        {
            await SafeJSLog($"TriggerWorkflowNow: Triggering workflow {workflow.Id}");

            if (workflow.IsQuartzManaged)
            {
                // Use Quartz.NET API to trigger workflow
                var response = await Http.PostAsync($"https://localhost:7042/api/workflows/{workflow.Id}/trigger", null);
                if (response.IsSuccessStatusCode)
                {
                    await JS.InvokeVoidAsync("alert", $"Workflow '{workflow.Name}' triggered successfully!");
                    await LoadSchedules(); // Refresh to show updated status
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", $"Failed to trigger workflow: {response.StatusCode}");
                }
            }
            else
            {
                // Use legacy API
                var success = await WorkflowService.TriggerWorkflowAsync(workflow.Id);
                if (success)
                {
                    await JS.InvokeVoidAsync("alert", $"Workflow '{workflow.Name}' triggered successfully!");
                    await LoadSchedules();
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", "Failed to trigger workflow");
                }
            }
        }
        catch (Exception ex)
        {
            await SafeJSError($"TriggerWorkflowNow error: {ex.Message}");
            await JS.InvokeVoidAsync("alert", $"Error triggering workflow: {ex.Message}");
        }
