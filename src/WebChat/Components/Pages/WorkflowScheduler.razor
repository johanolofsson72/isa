    private async Task OnWorkflowSelected(ChangeEventArgs e)
    {
        if (e.Value == null || string.IsNullOrEmpty(e.Value.ToString()))
        {
            selectedWorkflow = null;
            isSchedulingEnabled = false;
            availableSteps.Clear();
            onSuccessStep = string.Empty;
            onErrorStep = string.Empty;
            onSuccessValidation = string.Empty;
            onErrorValidation = string.Empty;
            return;
        }

        var id = e.Value.ToString();
        selectedWorkflowId = id!;

        // Check if this workflow already has a schedule
        var existingSchedule = schedules.FirstOrDefault(s => s.Id == id);
        if (existingSchedule != null)
        {
            selectedWorkflow = existingSchedule;
            isSchedulingEnabled = true;
            cronExpression = existingSchedule.Schedule;
            UpdateCronDescription();
        }
        else
        {
            // Find the workflow in the workflows list
            var workflow = workflows.FirstOrDefault(w => w.Id == id);
            if (workflow != null)
            {
                selectedWorkflow = new WorkflowScheduleInfo
                {
                    Id = workflow.Id,
                    Name = workflow.Name,
                    Description = workflow.Description,
                    Schedule = cronExpression,
                    Enabled = false
                };
                isSchedulingEnabled = false;
            }
        }

        // Load available steps for navigation validation
        if (selectedWorkflow != null)
        {
            await LoadAvailableSteps();

            // Clear previous navigation settings
            onSuccessStep = string.Empty;
            onErrorStep = string.Empty;
            onSuccessValidation = string.Empty;
            onErrorValidation = string.Empty;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveSchedule()
    {
