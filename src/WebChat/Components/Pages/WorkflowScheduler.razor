    private async Task LoadWorkflows()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            await SafeJSLog("LoadWorkflows: Starting to load workflows...");
            var result = await WorkflowService.GetWorkflowsAsync();

            await SafeJSLog($"LoadWorkflows: Got {result?.Count ?? 0} workflows");

            if (result != null)
            {
                // Convert WorkflowModel to WorkflowInfo for the scheduler
                workflows = result.Select(w => new WorkflowInfo
                {
                    Id = w.Id,
                    Name = w.Name,
                    Description = w.Description,
                    Enabled = w.Enabled,
                    ExecutionType = w.ExecutionType,
                    Schedule = w.Schedule ?? ""
                }).ToList();

                await SafeJSLog($"LoadWorkflows: Converted to {workflows.Count} WorkflowInfo items");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading workflows: {ex.Message}";
            await SafeJSError(errorMessage);
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadSchedules()
    {
        try
        {
            await SafeJSLog("LoadSchedules: Starting to load schedules...");
            await SafeJSLog($"HTTP Client BaseAddress: {WorkflowService.GetBaseAddress()}");

            var result = await WorkflowService.GetScheduledWorkflowsAsync();

            await SafeJSLog($"LoadSchedules: Got {result?.Count ?? 0} legacy workflows");

            // Load from both old system and new Quartz.NET system
            var quartzResult = await LoadQuartzSchedules();

            // Combine results, prioritizing Quartz.NET data
            var combinedSchedules = new List<WorkflowScheduleInfo>();

            // Add Quartz.NET schedules first
            if (quartzResult != null)
            {
                combinedSchedules.AddRange(quartzResult);
            }

            // Add legacy schedules that aren't already in Quartz
            if (result != null)
            {
                foreach (var legacy in result)
                {
                    if (!combinedSchedules.Any(q => q.Id == legacy.Id))
                    {
                        combinedSchedules.Add(new WorkflowScheduleInfo
                        {
                            Id = legacy.Id,
                            Name = legacy.Name,
                            Description = legacy.Description ?? string.Empty,
                            Schedule = legacy.Schedule,
                            Enabled = legacy.Enabled,
                            LastExecuted = legacy.LastExecuted,
                            NextExecutionTime = legacy.NextExecutionTime,
                            IsQuartzManaged = false,
                            Status = legacy.Enabled ? "Legacy" : "Disabled"
                        });
                    }
                }
            }

            schedules = combinedSchedules;

            // Logga resultaten för felsökning
            await SafeJSLog($"LoadSchedules: Got {schedules.Count} total workflows ({quartzResult?.Count ?? 0} Quartz, {result?.Count ?? 0} legacy)");

            foreach (var s in schedules)
            {
                await SafeJSLog($"Schedule: {s.Id} - {s.Name} - {s.Schedule} - Quartz: {s.IsQuartzManaged} - Status: {s.Status}");
            }

            if (schedules.Count == 0)
