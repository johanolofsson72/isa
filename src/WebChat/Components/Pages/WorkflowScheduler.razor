            var update = new WorkflowScheduleUpdateModel
            {
                Schedule = scheduleExpression,
                Enabled = isSchedulingEnabled,
                Timezone = selectedTimezone,
                MisfireHandling = selectedMisfireHandling,
                OnSuccess = string.IsNullOrWhiteSpace(onSuccessStep) ? null : onSuccessStep,
                OnError = string.IsNullOrWhiteSpace(onErrorStep) ? null : onErrorStep
            };

            var success = await WorkflowService.UpdateWorkflowScheduleAsync(selectedWorkflow.Id, update);
            if (success)
            {
                await JS.InvokeVoidAsync("alert", "Workflow schema sparades framgångsrikt!");
                await LoadSchedules();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Fel vid sparande av schema.");
            }
        }
        catch (Exception ex)
        {
            await SafeJSError($"Error saving schedule: {ex.Message}");
            await JS.InvokeVoidAsync("alert", $"Fel vid sparande av schema: {ex.Message}");
