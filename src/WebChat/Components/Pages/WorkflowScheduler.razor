    private async Task ValidateNavigationSteps()
    {
        onSuccessValidation = string.Empty;
        onErrorValidation = string.Empty;

        if (selectedWorkflow != null)
        {
            try
            {
                // Load available steps from the selected workflow
                await LoadAvailableSteps();

                // Validate OnSuccess step
                if (!string.IsNullOrWhiteSpace(onSuccessStep))
                {
                    if (!IsValidStepReference(onSuccessStep))
                    {
                        onSuccessValidation = $"Steg '{onSuccessStep}' finns inte i arbetsflödet";
                    }
                }

                // Validate OnError step
                if (!string.IsNullOrWhiteSpace(onErrorStep))
                {
                    if (!IsValidStepReference(onErrorStep))
                    {
                        onErrorValidation = $"Steg '{onErrorStep}' finns inte i arbetsflödet";
                    }
                }
            }
            catch (Exception ex)
            {
                await SafeJSError($"Error validating navigation steps: {ex.Message}");
            }
        }
    }

    private async Task LoadAvailableSteps()
    {
        availableSteps.Clear();

        if (selectedWorkflow != null)
        {
            try
            {
                // Get workflow details to extract step IDs
                var workflowDetails = await WorkflowService.GetWorkflowAsync(selectedWorkflow.Id);
                if (workflowDetails != null && workflowDetails.Steps != null)
                {
                    foreach (var step in workflowDetails.Steps)
                    {
                        if (!string.IsNullOrWhiteSpace(step.Name))
                        {
                            // Use step name as the ID for navigation
                            availableSteps.Add(step.Name);
                        }
                    }
                }

                // Add special step names
                availableSteps.AddRange(new[] { "completed", "failed", "cancelled", "end", "exit" });
            }
            catch (Exception ex)
            {
                await SafeJSError($"Error loading available steps: {ex.Message}");
            }
        }
    }

    private bool IsValidStepReference(string stepName)
    {
        if (string.IsNullOrWhiteSpace(stepName))
            return true;

        // Check if it's a special step name
        var specialSteps = new[] { "completed", "failed", "cancelled", "end", "exit" };
        if (specialSteps.Contains(stepName, StringComparer.OrdinalIgnoreCase))
            return true;

        // Check if it's in the available steps
        return availableSteps.Contains(stepName, StringComparer.OrdinalIgnoreCase);
    }

    private void ValidateCurrentSchedule()
    {
        try
        {
            var scheduleToValidate = useHumanReadableFormat ? humanScheduleExpression : cronExpression;

            if (string.IsNullOrWhiteSpace(scheduleToValidate))
            {
                scheduleIsValid = false;
                scheduleValidationMessage = "Schema kan inte vara tomt";
                scheduleDescription = string.Empty;
                return;
            }

            // Here we would call the Agent API to validate the schedule
            // For now, we'll do basic validation
            if (useHumanReadableFormat)
            {
                scheduleIsValid = ValidateHumanReadableSchedule(scheduleToValidate);
                scheduleValidationMessage = scheduleIsValid ?
                    "Giltigt läsbart schema" :
                    "Ogiltigt läsbart schema. Försök med format som 'daily at 9am' eller 'every monday at 2pm'";
                scheduleDescription = scheduleIsValid ? GetHumanScheduleDescription(scheduleToValidate) : string.Empty;
            }
            else
            {
                scheduleIsValid = ValidateCronExpression(scheduleToValidate);
                scheduleValidationMessage = scheduleIsValid ?
                    "Giltigt CRON-uttryck" :
                    "Ogiltigt CRON-uttryck. Använd format som '0 9 * * *' eller '*/5 * * * *'";
                scheduleDescription = scheduleIsValid ? GetCronDescription(scheduleToValidate) : string.Empty;
            }
        }
        catch (Exception ex)
        {
            scheduleIsValid = false;
            scheduleValidationMessage = $"Fel vid validering: {ex.Message}";
            scheduleDescription = string.Empty;
        }
    }

    private bool ValidateHumanReadableSchedule(string schedule)
    {
        var lowerSchedule = schedule.ToLowerInvariant().Trim();

        // Basic validation for common patterns
        if (lowerSchedule == "hourly" || lowerSchedule == "daily" ||
            lowerSchedule == "weekly" || lowerSchedule == "monthly")
            return true;

        if (lowerSchedule.StartsWith("daily at ") && lowerSchedule.Contains("am") || lowerSchedule.Contains("pm"))
            return true;

        if (lowerSchedule.StartsWith("every ") && lowerSchedule.Contains(" at ") &&
            (lowerSchedule.Contains("am") || lowerSchedule.Contains("pm")))
            return true;

        return false;
    }

    private bool ValidateCronExpression(string cron)
    {
        if (string.IsNullOrWhiteSpace(cron))
            return false;

        var parts = cron.Split(' ');
        return parts.Length == 5 || parts.Length == 6; // Basic validation
    }

    private string GetHumanScheduleDescription(string schedule)
    {
        var lowerSchedule = schedule.ToLowerInvariant().Trim();

        return lowerSchedule switch
        {
            "hourly" => "Körs varje timme",
            "daily" => "Körs dagligen kl 09:00",
            "weekly" => "Körs veckovis på måndag kl 09:00",
            "monthly" => "Körs månadsvis den 1:a kl 09:00",
            _ when lowerSchedule.StartsWith("daily at ") => $"Körs dagligen {lowerSchedule.Substring("daily at ".Length)}",
            _ when lowerSchedule.StartsWith("every ") => $"Körs {lowerSchedule}",
            _ => "Anpassat schema"
        };
    }

    private string GetCronDescription(string cron)
    {
        // This is a simplified CRON description function
        // In a real app, you would want to use a proper CRON parser library

        if (string.IsNullOrEmpty(cron))
            return string.Empty;

        var parts = cron.Split(' ');
        if (parts.Length != 5)
            return "Invalid CRON expression";

        var minute = parts[0];
        var hour = parts[1];
        var dayOfMonth = parts[2];
        var month = parts[3];
        var dayOfWeek = parts[4];

        // Simplified description generator
        if (minute == "0" && hour == "9" && dayOfMonth == "*" && month == "*" && dayOfWeek == "*")
            return "Runs daily at 9:00 AM";

        if (minute == "0" && hour == "9" && dayOfMonth == "*" && month == "*" && dayOfWeek == "1-5")
            return "Runs every weekday at 9:00 AM";

        if (minute == "0" && hour == "*/2" && dayOfMonth == "*" && month == "*" && dayOfWeek == "*")
            return "Runs every 2 hours";

        if (minute == "0" && hour == "0" && dayOfMonth == "1" && month == "*" && dayOfWeek == "*")
            return "Runs at midnight on the first day of every month";

        if (minute == "0" && hour == "9" && dayOfMonth == "*/2" && month == "*" && dayOfWeek == "*")
            return "Runs at 9:00 AM every other day";

        return $"Runs at custom schedule: {cron}";
    }

