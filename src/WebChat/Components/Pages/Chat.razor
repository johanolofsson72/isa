@page "/"
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Configuration
@using System
@using System.Text.Json
@using WebChat.Services
@using WebChat.Services.Interfaces
@using WebChat.Endpoints
@using Shared.Models
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject IHttpClientFactory HttpClientFactory
@inject ILogger<Chat> Logger
@inject ILoggerFactory LoggerFactory
@inject Shared.Services.IDeviceFingerprintService DeviceService
@inject WebChat.Services.Interfaces.IMemoryQueryService MemoryService
@inject WebChat.Services.Interfaces.ISessionFileService SessionFileService

<PageTitle>Chatt - Isa</PageTitle>

<div class="chat-container">
    <div class="page-header">
        <h1>Chatt</h1>
        <div style="display: flex; align-items: center; gap: 0.5rem;">
            <button @onclick="ToggleMute" class="mute-btn" title="@MuteTooltip">
                @if (IsMuted)
                {
                    <span class="bi bi-volume-mute-fill" style="color: #d9534f;"></span>
                }
                else
                {
                    <span class="bi bi-volume-up-fill" style="color: #5cb85c;"></span>
                }
            </button>
            <div class="connection-status">
                @if (IsConnected)
                {
                    <span class="status-connected"><span class="bi bi-circle-fill"></span> Ansluten</span>
                }
                else
                {
                    <span class="status-disconnected"><span class="bi bi-circle-fill"></span> Frånkopplad</span>
                }
            </div>
            <button class="btn btn-link d-lg-none" title="Visa statistik" @onclick="ToggleMobileStats">
                <span class="bi bi-graph-up"></span>
            </button>
        </div>
    </div>

    <div class="chat-messages" @ref="messagesContainer" data-testid="chat-messages">
        @if (messages.Count == 0)
        {
            <div class="welcome-message">
                <span class="bi bi-robot empty-icon"></span>
                <h2>@WelcomeMessage</h2>
                <p>@WelcomePhrase</p>
                <div class="welcome-actions">
                    <a href="/docs/IsaGuide" class="btn btn-outline-primary" target="_blank">
                        <span class="bi bi-book"></span> Dokumentation
                    </a>
                </div>
            </div>
        }
        else
        {
            @foreach (var message in messages)
            {
                <div class="message @(message.IsUser ? "user-message" : "agent-message")">
                    <div class="message-avatar">
                        @if (message.IsUser)
                        {
                            <span class="bi bi-person-circle"></span>
                        }
                        else
                        {
                            <span class="bi bi-robot"></span>
                        }
                    </div>
                    <div class="message-content">
                        <div class="message-text">@message.Text</div>
                        <div class="message-time">@message.Timestamp.ToString("HH:mm")</div>
                    </div>
                </div>
            }
        }

        @if (isTyping)
        {
            <div class="message agent-message typing">
                <div class="message-avatar">
                    <span class="bi bi-robot"></span>
                </div>
                <div class="message-content">
                    <div class="typing-indicator">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                </div>
            </div>
        }
    </div>

    <StatsPanel CurrentMessage="@messageInput" TotalMessages="@messages.Count" Messages="@MessagesAsObjects" />

    @* Mobile-only bottom sheet stats (outside typing block so toggle works) *@
    @if (isMobileStatsOpen)
    {
        <div class="stats-panel mobile-open" style="z-index:2000;">
            <div class="stats-header" @onclick="ToggleMobileStats">
                <strong>Stats</strong>
                <span style="margin-left:auto">Stäng</span>
            </div>
            <div class="stats-body">
                <div class="stat-row"><span>Current msg</span><span>@(messageInput?.Length ?? 0) chars</span></div>
                <div class="stat-row"><span>Messages</span><span>@messages.Count</span></div>
                <div class="stat-row"><span>History size</span><span>@GetHistoryCharacterCount() chars</span></div>
                <div class="stat-row"><span>Est. tokens</span><span>@GetEstimatedTokenCount()</span></div>
            </div>
        </div>
    }

    <div class="chat-input">
        @* File upload area *@
        <div class="file-upload-area @(sessionFiles.Any() ? "has-files" : "")">
            <div class="file-upload-header">
                <span class="file-upload-title">
                    Uppladdade filer 
                    @if (sessionFiles.Any())
                    {
                        <span class="file-count">(@sessionFiles.Count)</span>
                    }
                </span>
                <InputFile OnChange="OnFileSelected" class="file-input" accept="image/*,application/pdf,.pdf,.jpg,.jpeg,.png,.gif,.bmp,.tiff,.txt,.doc,.docx,.xls,.xlsx,text/plain" @ref="fileInputRef" />

                <!-- Safari desktop fallback: visible file input -->
                <div class="safari-desktop-file-wrapper">
                    <InputFile OnChange="OnFileSelected" class="safari-desktop-file-input" accept="image/*,application/pdf,.pdf,.jpg,.jpeg,.png,.gif,.bmp,.tiff,.txt,.doc,.docx,.xls,.xlsx,text/plain" />
                    <div class="safari-desktop-file-overlay">
                        <span class="bi bi-paperclip"></span>
                        <span>Ladda upp</span>
                    </div>
                </div>

                <!-- iOS fallback: visible file input -->
                <div class="ios-file-wrapper">
                    <InputFile OnChange="OnFileSelected" class="ios-file-input" accept="image/*,application/pdf,.pdf,.jpg,.jpeg,.png,.gif,.bmp,.tiff,.txt,.doc,.docx,.xls,.xlsx,text/plain" />
                    <div class="ios-file-overlay">
                        <span class="bi bi-paperclip"></span>
                        <span>Ladda upp</span>
                    </div>
                </div>

                <button @onclick="TriggerFileUpload" class="file-upload-btn" disabled="@(!IsConnected || isTyping)" title="Ladda upp fil">
                    <span class="bi bi-paperclip"></span>
                    <span>Ladda upp</span>
                </button>
            </div>
            @if (sessionFiles.Any())
            {
                <div class="file-list">
                    @foreach (var file in sessionFiles)
                    {
                        <div class="file-item">
                            <div class="file-info">
                                <span class="file-name" title="@file.FileName">@file.FileName</span>
                                <span class="file-size">@FormatFileSize(file.FileSize)</span>
                            </div>
                            <button @onclick="() => DeleteFile(file.FileId)" class="file-delete-btn" title="Radera fil">
                                <span class="bi bi-trash"></span>
                            </button>
                        </div>
                    }
                </div>
                <div class="file-upload-help">
                    <span class="bi bi-info-circle"></span>
                    <span>Skriv "importera fakturan till Fortnox" för att behandla uppladdade filer</span>
                </div>
            }
        </div>

        <div class="input-container">
            <div class="speech-controls">
                <button @onclick="ToggleRecording"
                        class="speech-button @(isRecording ? "recording" : "")"
                        disabled="@(!IsConnected || isTyping)"
                        title="@(isRecording ? "Stoppa inspelning" : "Starta röstinspelning")">
                    @if (isRecording)
                    {
                        <span class="bi bi-record-circle-fill"></span>
                    }
                    else
                    {
                        <span class="bi bi-mic"></span>
                    }
                </button>
                <button @onclick="ClearMessage"
                        class="clear-button"
                        disabled="@(!IsConnected || isTyping || string.IsNullOrWhiteSpace(messageInput))"
                        title="Rensa meddelande">
                    <span class="bi bi-trash"></span>
                </button>
            </div>
            <textarea id="messageInput" @bind="messageInput" @bind:event="oninput" @onkeydown="@HandleKeyDown"
                   placeholder="Fråga mej något..."
                   disabled="@(!IsConnected || isTyping)"
                   class="message-input"
                   rows="2"
                   @ref="messageInputRef"
                   data-testid="chat-input"></textarea>
            <button @onclick="SendMessageAndClear" disabled="@(!IsConnected || isTyping || string.IsNullOrWhiteSpace(messageInput))"
                    class="send-button"
                    data-testid="send-button">
                <span class="bi bi-send"></span>
            </button>
        </div>

        @if (isRecording)
        {
            <div class="recording-status">
                <span class="recording-indicator"><span class="bi bi-record-circle-fill pulse"></span> Spelar in... Säg "Kör" för att skicka ditt meddelande</span>
            </div>
        }

        @* Quick actions hidden for now *@
        <div class="quick-actions" style="display: none;">
            <button @onclick="async () => await SetQuickMessage(QuickMessages.SendEmails)" class="quick-btn" disabled="@(!IsConnected || isTyping)">
                <span class="bi bi-envelope-fill"></span> Skicka 3 e-post till Agent
            </button>
            <button @onclick="async () => await SetQuickMessage(QuickMessages.ReadEmails)" class="quick-btn" disabled="@(!IsConnected || isTyping)">
                <span class="bi bi-inbox-fill"></span> Läs e-post
            </button>
            <button @onclick="async () => await SetQuickMessage(QuickMessages.SendSms)" class="quick-btn" disabled="@(!IsConnected || isTyping)">
                <span class="bi bi-phone-fill"></span> Skicka SMS
            </button>
            <button @onclick="async () => await SetQuickMessage(QuickMessages.SendTeamsMessage)" class="quick-btn" disabled="@(!IsConnected || isTyping)">
                <span class="bi bi-chat-fill"></span> Säg hej på Teams
            </button>
        </div>
    </div>
</div>

@code {
    private ChatService? chatService;
    private List<ChatMessage> messages = new();
    private string messageInput = string.Empty;
    private bool isTyping = false;
    private bool isRecording = false;
    private ElementReference messagesContainer;
    private ElementReference messageInputRef;
    private string WelcomeMessage = "Välkommen, jag heter Isa";
    private string WelcomePhrase = "Hur kan jag hjälpa dig idag?";
    // Ta bort flaggan lastMessageWasVoice

    // File upload related fields
    private InputFile? fileInputRef;
    private List<SessionFileInfo> sessionFiles = new();
    private string? currentSessionId;

    public bool IsConnected => chatService?.IsConnected ?? false;
    private bool isMobileStatsOpen = false;
    private void ToggleMobileStats() => isMobileStatsOpen = !isMobileStatsOpen;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Initialize device fingerprint using shared DeviceFingerprintService
            var deviceFingerprint = await DeviceService.GetOrCreateDeviceFingerprintAsync();
            Logger.LogInformation("🔍 DEVICE DEBUG: Chat.razor got device fingerprint: {DeviceFingerprint}", deviceFingerprint);

            // Get personal information for personalized welcome message
            await LoadPersonalizedWelcomeAsync(deviceFingerprint);

            // Initialize ChatService
            var logger = LoggerFactory.CreateLogger<ChatService>();
            chatService = new ChatService(HttpClientFactory, logger, DeviceService);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during Chat initialization");
            // Fallback: create ChatService without device fingerprint
            var logger = LoggerFactory.CreateLogger<ChatService>();
            chatService = new ChatService(HttpClientFactory, logger, DeviceService);
        }

        // Set up event handlers
        chatService.OnConnected += () =>
        {
            InvokeAsync(() =>
            {
                StateHasChanged();
            });
        };

        chatService.OnMessageReceived += async (message) =>
        {
            await InvokeAsync(async () =>
            {
                isTyping = false;
                AddMessage("🤖 Agent", message.Text, false);
                StateHasChanged();
                await ScrollToBottom();

                // Sätt fokus tillbaka till textrutan när Isa har svarat
                await Task.Delay(100); // Kort delay för att säkerställa att DOM är uppdaterad
                await JS.InvokeVoidAsync("focusMessageInput");

                // TTS endast om ljudet inte är avstängt
                if (!IsMuted)
                {
                    var subscriptionKey = Configuration["AzureSpeech:SubscriptionKey"];
                    var region = Configuration["AzureSpeech:Region"];
                    if (!string.IsNullOrWhiteSpace(subscriptionKey) && !string.IsNullOrWhiteSpace(region))
                    {
                        await JS.InvokeVoidAsync("speakWithAzure", message.Text, subscriptionKey, region);
                    }
                }
            });
        };

        chatService.OnError += (error) =>
        {
            InvokeAsync(async () =>
            {
                isTyping = false;
                AddMessage("❌ Fel", error, false);
                StateHasChanged();

                // Sätt fokus tillbaka till textrutan även vid fel
                await Task.Delay(100);
                await JS.InvokeVoidAsync("focusMessageInput");
            });
        };

        try
        {
            await chatService.InitializeAsync();

            // Initialize session ID and clear files (requirement: clear files when chat is opened)
            await InitializeSessionAsync();

            AddMessage("🤖 Isa", GetPersonalizedWelcomeMessage(), false);

            // Sätt fokus på textrutan efter välkomstmeddelandet (säkert JSInterop)
            await SafeInvokeJSAsync("focusMessageInput");

            // Lägg till TTS för välkomstmeddelandet
            if (!IsMuted)
            {
                var subscriptionKey = Configuration["AzureSpeech:SubscriptionKey"];
                var region = Configuration["AzureSpeech:Region"];
                if (!string.IsNullOrWhiteSpace(subscriptionKey) && !string.IsNullOrWhiteSpace(region))
                {
                    await SafeInvokeJSAsync("speakWithAzure", "Välkommen jag heter Isa, hur kan jag hjälpa dig idag?", subscriptionKey, region);
                }
            }
        }
        catch (Exception ex)
        {
            AddMessage("❌ System", $"Kunde inte ansluta till Agent: {ex.Message}", false);
            Console.WriteLine($"SignalR connection failed: {ex}");

            // Sätt fokus även vid anslutningsfel (säkert JSInterop)
            await SafeInvokeJSAsync("focusMessageInput");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Prevent mobile scrolling with JavaScript (only on chat page)
            await JS.InvokeVoidAsync("preventMobileScrollingOnChatPage");

            // Show Safari desktop file input if needed
            await JS.InvokeVoidAsync("showSafariDesktopFileInput");

            // Sätt fokus på textrutan när sidan laddas
            await Task.Delay(200); // Lite längre delay för första renderingen
            await JS.InvokeVoidAsync("focusMessageInput");
        }
    }

    private async Task ToggleRecording()
    {
        if (isRecording)
        {
            await StopRecording();
        }
        else
        {
            await StartRecording();
        }
    }

    private async Task StartRecording()
    {
        try
        {
            isRecording = true;
            StateHasChanged();

            // Start speech recognition using JavaScript
            await JS.InvokeVoidAsync("startSpeechRecognition", DotNetObjectReference.Create(this));
        }
        catch (Exception ex)
        {
            isRecording = false;
            AddMessage("❌ Röstfel", $"Kunde inte starta röstinspelning: {ex.Message}", false);
            StateHasChanged();
        }
    }

    private async Task StopRecording()
    {
        try
        {
            isRecording = false;
            StateHasChanged();

            // Stop speech recognition using JavaScript
            await JS.InvokeVoidAsync("stopSpeechRecognition");
        }
        catch (Exception ex)
        {
            AddMessage("❌ Röstfel", $"Kunde inte stoppa röstinspelning: {ex.Message}", false);
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnSpeechResult(string transcript)
    {
        messageInput = transcript;
        StateHasChanged();

        // Check if the transcript contains "execute" to auto-send
        if (transcript.ToLowerInvariant().Contains("execute") || transcript.ToLowerInvariant().Contains("kör"))
        {
            // Remove "execute"/"kör" from the message
            messageInput = transcript.Replace("execute", "", StringComparison.OrdinalIgnoreCase)
                                   .Replace("kör", "", StringComparison.OrdinalIgnoreCase).Trim();
            StateHasChanged();

            await Task.Delay(500); // Small delay for visual feedback
            // StopRecording will be called automatically by SendMessage()
            await SendMessage();
        }
    }

    [JSInvokable]
    public void OnSpeechError(string error)
    {
        isRecording = false;
        AddMessage("❌ Röstfel", $"Röstigenkänning misslyckades: {error}", false);
        StateHasChanged();
    }

    private void ClearMessage()
    {
        messageInput = string.Empty;
        StateHasChanged();
    }



    private async Task SendMessage()
    {
        Console.WriteLine("🔍 SEND MESSAGE DEBUG: Starting SendMessage()");
        Console.WriteLine($"🔍 SEND MESSAGE DEBUG: messageInput='{messageInput}', IsConnected={IsConnected}");

        if (string.IsNullOrWhiteSpace(messageInput) || !IsConnected)
        {
            Console.WriteLine("🔍 SEND MESSAGE DEBUG: Exiting early - messageInput empty or not connected");
            return;
        }

        // Stop recording if it's active
        if (isRecording)
        {
            await StopRecording();
        }

        var message = messageInput.Trim();

        // Add file IDs to message if there are uploaded files
        if (sessionFiles.Any())
        {
            var fileIds = string.Join(", ", sessionFiles.Select(f => f.FileId));
            message += $"\n\n[FILER: {fileIds}]";
            Console.WriteLine($"🔍 SEND MESSAGE DEBUG: Added file IDs to message: {fileIds}");
        }

        Console.WriteLine($"🔍 SEND MESSAGE DEBUG: Final message='{message}'");

        AddMessage("Du", message, true);
        isTyping = true;

        // Clear file area immediately when sending message
        if (sessionFiles.Any())
        {
            Console.WriteLine($"🔍 SEND MESSAGE DEBUG: Clearing {sessionFiles.Count} files from file area");
            await ClearAllSessionFiles();
            Console.WriteLine("🔍 SEND MESSAGE DEBUG: File clearing completed");

            // Update mobile input position after clearing files
            await UpdateMobileInputPosition();
        }

        StateHasChanged();
        await ScrollToBottom();

        Console.WriteLine("🔍 SEND MESSAGE DEBUG: About to send to Agent via chatService");

        // Always send message to Agent
        if (chatService is not null)
        {
            Console.WriteLine($"🔍 SEND MESSAGE DEBUG: Calling chatService.SendMessageAsync('{message}')");
            await chatService.SendMessageAsync(message);
            Console.WriteLine("🔍 SEND MESSAGE DEBUG: chatService.SendMessageAsync completed");

            // Return focus to input field
            await Task.Delay(100); // Small delay to ensure DOM is updated
            await JS.InvokeVoidAsync("focusElement", "messageInput");
        }
        else
        {
            Console.WriteLine("🔍 SEND MESSAGE DEBUG: chatService is null!");
        }

        // File import is now handled by Agent via DocumentInterpreter - no need for separate processing

        Console.WriteLine("🔍 SEND MESSAGE DEBUG: SendMessage() completed");

        // keep helpers outside of hub block
        // mobile stats panel
        // fields are below

    }

    private async Task SendMessageAndClear()
    {
        Console.WriteLine("🔍 SEND BUTTON DEBUG: About to send message and clear input");
        await SendMessage();

        // Force clear the textarea immediately after sending
        try
        {
            Console.WriteLine("🔍 SEND BUTTON DEBUG: About to clear textarea via JavaScript");
            await JS.InvokeVoidAsync("eval", "document.getElementById('messageInput').value = '';");
            Console.WriteLine("🔍 SEND BUTTON DEBUG: Textarea cleared via JavaScript");

            // Also clear the backend variable
            messageInput = string.Empty;
            StateHasChanged();
            Console.WriteLine("🔍 SEND BUTTON DEBUG: Backend variable cleared and StateHasChanged called");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"🔍 SEND BUTTON DEBUG: JavaScript clear failed: {ex.Message}");
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        Console.WriteLine($"KeyDown: {e.Key}, CtrlKey: {e.CtrlKey}, MetaKey: {e.MetaKey}");
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey))
        {
            // Ctrl+Enter (Windows/Linux) or Cmd+Enter (Mac) sends message
            Console.WriteLine("🔍 CTRL/CMD+ENTER DEBUG: About to send message and clear input");

            // Prevent default behavior (adding newline)
            await JS.InvokeVoidAsync("eval", "event.preventDefault();");

            // Wait for SendMessage to complete before clearing
            await SendMessage();
            Console.WriteLine("🔍 CTRL/CMD+ENTER DEBUG: SendMessage completed, now clearing input");

            // Force clear the textarea immediately after sending
            try
            {
                Console.WriteLine("🔍 CTRL/CMD+ENTER DEBUG: About to clear textarea via JavaScript");
                await JS.InvokeVoidAsync("eval", "document.getElementById('messageInput').value = '';");
                Console.WriteLine("🔍 CTRL/CMD+ENTER DEBUG: Textarea cleared via JavaScript");

                // Also clear the backend variable
                messageInput = string.Empty;
                StateHasChanged();
                Console.WriteLine("🔍 CTRL/CMD+ENTER DEBUG: Backend variable cleared and StateHasChanged called");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"🔍 CTRL/CMD+ENTER DEBUG: JavaScript clear failed: {ex.Message}");
            }
        }
        // Enter without Ctrl/Cmd just adds a new line (default textarea behavior)
    }

    // File handling methods
    private async Task InitializeSessionAsync()
    {
        try
        {
            // Get session ID (same logic as ChatService)
            var deviceFingerprint = await DeviceService.GetOrCreateDeviceFingerprintAsync();
            currentSessionId = $"session_{deviceFingerprint}";

            // Clear session files when chat is opened (per requirement)
            await SessionFileService.ClearSessionFilesAsync(currentSessionId);
            Logger.LogInformation("Cleared session files for: {SessionId}", currentSessionId);

            // Load current session files (should be empty after clear)
            await LoadSessionFiles();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing session");
        }
    }

    private async Task LoadSessionFiles()
    {
        if (string.IsNullOrEmpty(currentSessionId))
            return;

        try
        {
            sessionFiles = await SessionFileService.GetSessionFilesAsync(currentSessionId);
            StateHasChanged();

            // Update mobile input position when files are loaded/changed
            await UpdateMobileInputPosition();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading session files");
        }
    }

    private async Task TriggerFileUpload()
    {
        if (fileInputRef?.Element != null)
        {
            await JS.InvokeVoidAsync("triggerFileInput", fileInputRef.Element);
        }
    }

    private async Task ClearFileInput()
    {
        if (fileInputRef?.Element != null)
        {
            await JS.InvokeVoidAsync("clearFileInput", fileInputRef.Element);
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles();
        if (!files.Any())
            return;

        foreach (var file in files)
        {
            try
            {
                if (string.IsNullOrEmpty(currentSessionId))
                {
                    AddMessage("❌ System", "Session inte initialiserad", false);
                    continue;
                }

                // Validate file size (max 10MB)
                const long maxFileSize = 10 * 1024 * 1024; // 10MB
                if (file.Size > maxFileSize)
                {
                    AddMessage("❌ System", $"Fil {file.Name} är för stor (max 10MB)", false);
                    continue;
                }

                // Validate file type
                var allowedTypes = new[] {
                    "image/",
                    "application/pdf",
                    "text/plain",
                    "application/msword",
                    "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                    "application/vnd.ms-excel",
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                };
                if (!allowedTypes.Any(type => file.ContentType.StartsWith(type) || file.ContentType == type))
                {
                    AddMessage("❌ System", $"Filtyp {file.ContentType} stöds inte (endast bilder, PDF, text och Office-dokument)", false);
                    continue;
                }

                Logger.LogInformation("Uploading file: {FileName} ({FileSize} bytes)", file.Name, file.Size);

                // Convert IBrowserFile to IFormFile-like structure for upload
                var fileId = await SessionFileService.UploadFileAsync(currentSessionId, new FormFileWrapper(file));

                AddMessage("📎 System", $"Fil uppladdad: {file.Name} ({FormatFileSize(file.Size)})", false);
                await LoadSessionFiles();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error uploading file: {FileName}", file.Name);
                AddMessage("❌ System", $"Kunde inte ladda upp fil {file.Name}: {ex.Message}", false);
            }
        }

        // Clear the file input after all files have been processed
        await ClearFileInput();
    }

    private async Task DeleteFile(string fileId)
    {
        if (string.IsNullOrEmpty(currentSessionId))
            return;

        try
        {
            var deleted = await SessionFileService.DeleteFileAsync(currentSessionId, fileId);
            if (deleted)
            {
                AddMessage("🗑️ System", "Fil raderad", false);
                await LoadSessionFiles();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting file: {FileId}", fileId);
            AddMessage("❌ System", $"Kunde inte radera fil: {ex.Message}", false);
        }
    }

    private async Task ClearAllSessionFiles()
    {
        if (string.IsNullOrEmpty(currentSessionId))
            return;

        try
        {
            Console.WriteLine($"🔍 CLEAR FILES DEBUG: Clearing {sessionFiles.Count} session files");

            // Clear the local list first for immediate UI update
            sessionFiles.Clear();
            Console.WriteLine("🔍 CLEAR FILES DEBUG: Local sessionFiles list cleared");

            // Force immediate UI update
            await InvokeAsync(StateHasChanged);
            Console.WriteLine("🔍 CLEAR FILES DEBUG: StateHasChanged called via InvokeAsync - UI should now show empty file area");

            // Update mobile input position after clearing files
            await UpdateMobileInputPosition();

            // Then delete files from the backend (this can happen in background)
            var filesToDelete = await SessionFileService.GetSessionFilesAsync(currentSessionId);
            foreach (var file in filesToDelete)
            {
                await SessionFileService.DeleteFileAsync(currentSessionId, file.FileId);
                Console.WriteLine($"🔍 CLEAR FILES DEBUG: Deleted file {file.FileName} ({file.FileId}) from backend");
            }

            Console.WriteLine("🔍 CLEAR FILES DEBUG: All files cleared from both UI and backend");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error clearing session files");
            Console.WriteLine($"🔍 CLEAR FILES DEBUG: Error clearing files: {ex.Message}");
        }
    }

    private string FormatFileSize(long bytes)
    {
        const int unit = 1024;
        if (bytes < unit) return $"{bytes} B";
        int exp = (int)(Math.Log(bytes) / Math.Log(unit));
        return $"{bytes / Math.Pow(unit, exp):F1} {("KMGTPE")[exp - 1]}B";
    }

