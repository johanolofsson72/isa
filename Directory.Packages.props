<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <EnablePackageVersionOverride>false</EnablePackageVersionOverride>
    <!-- Suppress .NET preview warnings -->
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <!-- Suppress package source mapping warnings -->
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>
  <!-- .NET 9 System Libraries - Force compatible versions -->
  <ItemGroup>
    <PackageVersion Include="Azure.AI.FormRecognizer" Version="4.1.0" />
    <PackageVersion Include="Blazored.LocalStorage" Version="4.5.0" />

    <PackageVersion Include="Microsoft.Data.Sqlite" Version="9.0.8" />
    <PackageVersion Include="Nito.AsyncEx" Version="5.1.2" />
    <PackageVersion Include="PDFiumSharp" Version="1.4660.0-alpha1" />
    <PackageVersion Include="PDFtoImage" Version="5.0.0" />
    <PackageVersion Include="Quartz" Version="3.15.0" OverrideVersion="true" />
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="3.15.0" OverrideVersion="true" />
    <PackageVersion Include="Quartz.Serialization.Json" Version="3.15.0" OverrideVersion="true" />
    <PackageVersion Include="SixLabors.ImageSharp.Drawing" Version="2.1.4" />
    <PackageVersion Include="SkiaSharp" Version="3.116.1" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="9.0.8" />
    <PackageVersion Include="System.Drawing.Common" Version="8.0.4" />
    <PackageVersion Include="System.Text.Json" Version="9.0.8" OverrideVersion="true" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>
  <!-- Microsoft Graph and Kiota - Updated versions -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Graph" Version="5.90.0" />
    <PackageVersion Include="Microsoft.Graph.Core" Version="3.2.4" />
    <PackageVersion Include="Microsoft.Kiota.Abstractions" Version="1.19.1" />
    <PackageVersion Include="Microsoft.Kiota.Authentication.Azure" Version="1.19.1" />
    <PackageVersion Include="Microsoft.Kiota.Http.HttpClientLibrary" Version="1.19.1" />
    <PackageVersion Include="Microsoft.Kiota.Serialization.Json" Version="1.19.1" />
    <PackageVersion Include="Microsoft.Kiota.Serialization.Text" Version="1.19.1" />
  </ItemGroup>
  <!-- Azure and Identity -->
  <ItemGroup>
    <PackageVersion Include="Azure.Identity" Version="1.15.0" />
    <PackageVersion Include="Azure.Core" Version="1.47.2" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.76.0" />
  </ItemGroup>
  <!-- .NET 9 Framework Libraries -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.8" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="9.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="9.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.8" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.8" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="9.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="9.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="9.8.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="9.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="9.0.8" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="9.4.1" />
  </ItemGroup>
  <!-- Third-party Libraries -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.SemanticKernel" Version="1.58.0" />
    <PackageVersion Include="OpenAI" Version="2.2.0-beta.4" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
    <PackageVersion Include="FluentAssertions" Version="6.12.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Moq" Version="4.20.70" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="9.0.8" />
  </ItemGroup>
  <!-- AnalysisPlugin-specific Libraries -->
  <ItemGroup>
    <PackageVersion Include="ClosedXML" Version="0.104.1" />
    <PackageVersion Include="Syncfusion.Pdf.Net.Core" Version="27.2.5" />
    <PackageVersion Include="MathNet.Numerics" Version="5.0.0" />
    <PackageVersion Include="Accord.Statistics" Version="3.8.0" />
  </ItemGroup>
  <!-- Plugin-specific Libraries -->
  <ItemGroup>
    <PackageVersion Include="Dropbox.Api" Version="7.0.0" OverrideVersion="true" />
    <PackageVersion Include="Google.Apis" Version="1.68.0" OverrideVersion="true" />
    <PackageVersion Include="Google.Apis.Core" Version="1.68.0" OverrideVersion="true" />
    <PackageVersion Include="Google.Apis.Drive.v3" Version="1.68.0.3568" OverrideVersion="true" />
    <PackageVersion Include="Google.Apis.Calendar.v3" Version="1.68.0.3592" OverrideVersion="true" />
    <PackageVersion Include="Google.Apis.Gmail.v1" Version="1.68.0.3564" OverrideVersion="true" />
    <PackageVersion Include="Google.Apis.CustomSearchAPI.v1" Version="1.68.0.3564" OverrideVersion="true" />
    <PackageVersion Include="Google.Apis.Auth" Version="1.68.0" OverrideVersion="true" />
    <PackageVersion Include="MailKit" Version="4.13.0" OverrideVersion="true" />
    <PackageVersion Include="MimeKit" Version="4.13.0" OverrideVersion="true" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" OverrideVersion="true" />
    <PackageVersion Include="RestSharp" Version="112.1.0" OverrideVersion="true" />
    <PackageVersion Include="Twilio" Version="7.8.0" OverrideVersion="true" />
    <PackageVersion Include="Slack.Webhooks" Version="1.1.5" OverrideVersion="true" />
    <PackageVersion Include="SlackAPI" Version="1.1.5" OverrideVersion="true" />
    <!-- OCR and PDF processing -->
    <PackageVersion Include="Tesseract" Version="5.2.0" OverrideVersion="true" />
    <PackageVersion Include="iText7" Version="8.0.5" OverrideVersion="true" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.11" OverrideVersion="true" />
    <PackageVersion Include="Azure.AI.Vision.ImageAnalysis" Version="1.0.0-beta.3" OverrideVersion="true" />
    <!-- Office document processing -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.2.0" OverrideVersion="true" />
    <PackageVersion Include="EPPlus" Version="7.5.2" OverrideVersion="true" />
    <PackageVersion Include="RtfPipe" Version="1.0.6905.3016" OverrideVersion="true" />
    <!-- Test-specific packages -->
    <PackageVersion Include="FakeItEasy" Version="8.3.0" OverrideVersion="true" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.0" OverrideVersion="true" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.49.0" OverrideVersion="true" />
    <PackageVersion Include="Xunit.Extensions.Logging" Version="1.0.0" OverrideVersion="true" />
  </ItemGroup>
  <!-- Aspire and OpenTelemetry -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="9.4.1" />
    <PackageVersion Include="Aspire.Hosting" Version="9.4.1" />
    <PackageVersion Include="Aspire.Hosting.Sqlite" Version="9.4.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.12.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.12.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.12.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.12.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.12.0" />
  </ItemGroup>
  <!-- Syncfusion (WebChat) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.8" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Core" Version="1.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR" Version="1.2.0" />
    <PackageVersion Include="Newtonsoft.Json.Schema" Version="4.0.1" />
    <PackageVersion Include="Syncfusion.Blazor" Version="27.2.5" />
    <PackageVersion Include="Syncfusion.Blazor.Themes" Version="27.2.5" />
  </ItemGroup>
  <!-- E2E Testing Packages -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Playwright.NUnit" Version="1.49.0" />
    <PackageVersion Include="NUnit" Version="4.2.2" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.3.0" />
  </ItemGroup>
  <!-- Override problematic transitive dependencies with force override -->
  <ItemGroup>
    <!-- Force modern versions to override old transitive dependencies -->
    <PackageVersion Include="SQLite.Native" Version="3.13.0" />
    <PackageVersion Include="Zlib.Portable" Version="1.11.0" />
    <!-- Aggressively override problematic old packages -->
    <PackageVersion Include="Common.Logging" Version="3.4.1" OverrideVersion="true" />
    <PackageVersion Include="ServiceStack.Text" Version="8.4.0" OverrideVersion="true" />
  </ItemGroup>
</Project>