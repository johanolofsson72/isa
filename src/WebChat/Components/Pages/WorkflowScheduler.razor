    private async Task ConfirmDeleteSchedule(WorkflowScheduleInfo schedule)
    {
        try
        {
            var ok = await JS.InvokeAsync<bool>("confirm", $"Radera schemat '{schedule.Name}'? Detta kan inte ångras.");
            if (!ok) return;

            var success = await DeleteSchedule(schedule);
            if (success)
            {
                schedules.Remove(schedule);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Fel vid radering: {ex.Message}";
        }
    }

    private async Task<bool> DeleteSchedule(WorkflowScheduleInfo schedule)
    {
        try
        {
            // Quartz-managed job: use Quartz Admin delete endpoint
            if (schedule.IsQuartzManaged)
            {
                var response = await WorkflowService.HttpClient.DeleteAsync($"/api/QuartzAdmin/jobs/{Uri.EscapeDataString(schedule.Id)}?jobGroup=DEFAULT");
                if (response.IsSuccessStatusCode)
                {
                    return true;
                }
                else
                {
                    errorMessage = $"Kunde inte radera Quartz-jobb: {response.StatusCode}";
                    return false;
                }
            }
            else
            {
                // Legacy: delete the underlying workflow definition
                var ok = await WorkflowService.DeleteWorkflowAsync(schedule.Id);
                if (!ok)
                {
                    errorMessage = "Kunde inte radera arbetsflödet via API";
                }
                return ok;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Fel vid radering: {ex.Message}";
            return false;
        }
    }


