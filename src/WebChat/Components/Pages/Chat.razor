<script>
    // Store the touchmove handler so we can remove it later
    let chatTouchMoveHandler = null;
    let originalBodyStyles = null;

    window.preventMobileScrollingOnChatPage = () => {
        if (window.innerWidth <= 767) {
            // Only apply scroll prevention if we're actually on the chat page
            const chatContainer = document.querySelector('.chat-container');
            if (!chatContainer) {
                return; // Not on chat page, don't prevent scrolling
            }

            // Store original body styles for restoration
            originalBodyStyles = {
                overflow: document.body.style.overflow,
                position: document.body.style.position,
                width: document.body.style.width,
                height: document.body.style.height
            };

            // Create the touchmove handler
            chatTouchMoveHandler = function(e) {
                // Only allow scrolling inside chat-messages
                const chatMessages = document.querySelector('.chat-messages');
                const chatInput = document.querySelector('.chat-input');
                let target = e.target;
                let isInsideChatMessages = false;
                let isInsideChatInput = false;

                // Check if the touch is inside chat-messages or chat-input
                while (target && target !== document) {
                    if (target === chatMessages) {
                        isInsideChatMessages = true;
                        break;
                    }
                    if (target === chatInput) {
                        isInsideChatInput = true;
                        break;
                    }
                    target = target.parentNode;
                }

                // If not inside chat-messages or chat-input, prevent scrolling
                if (!isInsideChatMessages && !isInsideChatInput) {
                    e.preventDefault();
                }
            };

            // Add the event listener
            document.addEventListener('touchmove', chatTouchMoveHandler, { passive: false });

            // Prevent body scrolling completely
            document.body.style.overflow = 'hidden';
            document.body.style.position = 'fixed';
            document.body.style.width = '100%';
            document.body.style.height = '100%';
            document.documentElement.style.overflow = 'hidden';
        }
    };

    // Cleanup function to restore normal scrolling when leaving chat page
    window.cleanupChatScrollPrevention = () => {
        // Remove the touchmove event listener if it exists
        if (chatTouchMoveHandler) {
            document.removeEventListener('touchmove', chatTouchMoveHandler);
            chatTouchMoveHandler = null;
        }

        // Restore original body styles
        if (originalBodyStyles) {
            document.body.style.overflow = originalBodyStyles.overflow;
            document.body.style.position = originalBodyStyles.position;
            document.body.style.width = originalBodyStyles.width;
            document.body.style.height = originalBodyStyles.height;
            originalBodyStyles = null;
        }

        // Also restore document element
        document.documentElement.style.overflow = '';

        // Ensure mobile scrolling works
        if (window.ensureMobileScrolling) {
            window.ensureMobileScrolling();
        }
    };

    // Cleanup when page is unloaded or navigated away
    window.addEventListener('beforeunload', cleanupChatScrollPrevention);

    // Cleanup for Blazor SPA navigation
    if (window.Blazor) {
        window.Blazor.addEventListener('enhancedload', () => {
            // If we're not on chat page anymore, cleanup
            if (!document.querySelector('.chat-container')) {
                cleanupChatScrollPrevention();
            }
        });
    }

    // Robust functions that can be called multiple times
    window.scrollToBottom = (element) => {
        try {
            if (element && typeof element.scrollTop !== 'undefined') {
                element.scrollTop = element.scrollHeight;
            }
        } catch (e) {
            console.warn('scrollToBottom failed:', e);
        }
    };

    window.focusElement = (elementId) => {
        try {
            const element = document.getElementById(elementId);
            if (element && typeof element.focus === 'function') {
                element.focus();
            }
        } catch (e) {
            console.warn('focusElement failed:', e);
        }
    };

    window.clearFileInput = (element) => {
        try {
            if (element && element.type === 'file') {
                // Clear the file input value
                element.value = '';

                // Also clear any internal state
                if (element.files) {
                    // Create a new FileList (empty)
                    const dt = new DataTransfer();
                    element.files = dt.files;
                }

                // Trigger change event to notify any listeners
                const event = new Event('change', { bubbles: true });
                element.dispatchEvent(event);
            }
        } catch (e) {
            console.warn('clearFileInput failed:', e);
        }
    };

    // Show Safari desktop file input if needed
    window.showSafariDesktopFileInput = () => {
        const isSafariDesktop = /Safari/.test(navigator.userAgent) &&
                               !/Chrome/.test(navigator.userAgent) &&
                               !/iPad|iPhone|iPod/.test(navigator.userAgent) &&
                               window.innerWidth >= 768;

        if (isSafariDesktop) {
            console.log('Safari desktop detected - showing alternative file input');
            const safariWrapper = document.querySelector('.safari-desktop-file-wrapper');
            const regularButton = document.querySelector('.file-upload-btn');

            if (safariWrapper && regularButton) {
                safariWrapper.style.display = 'block';
                regularButton.style.display = 'none';
            }
        }
    };

    window.triggerFileInput = (element) => {
        console.log('🔍 triggerFileInput called!');
        console.log('🔍 User Agent:', navigator.userAgent);
        console.log('🔍 Element:', element);
        console.log('🔍 Element type:', element ? element.type : 'null');

        try {
            if (element && element.type === 'file' && typeof element.click === 'function') {
                console.log('✅ Valid file input element found');

                // Clear any previous selection first
                element.value = '';

                // Safari specific handling
                if (/Safari/.test(navigator.userAgent) && !/Chrome/.test(navigator.userAgent)) {
                    console.log('Safari detected - using enhanced click handling');

                    // Only show warning for actual iOS simulators, not desktop Safari
                    const isIOSSimulator = /iPad|iPhone|iPod/.test(navigator.userAgent) &&
                                         window.navigator.platform === 'MacIntel' &&
                                         window.navigator.webdriver;

                    if (isIOSSimulator) {
                        console.warn('iOS Simulator detected - file upload may not work');
                        const fileArea = document.querySelector('.file-upload-area');
                        if (fileArea) {
                            fileArea.classList.add('safari-responsive-warning');
                        }
                    }

                    // Simplified Safari handling - just ensure element is clickable
                    console.log('Element visibility:', window.getComputedStyle(element).display, window.getComputedStyle(element).visibility);

                    // For desktop Safari, try direct click first
                    try {
                        console.log('Attempting direct Safari click...');
                        element.click();
                        console.log('Direct Safari click completed');
                    } catch (e1) {
                        console.log('Direct Safari click failed, trying enhanced method:', e1);

                        // Fallback: make element temporarily visible and try again
                        const originalStyles = {
                            position: element.style.position,
                            left: element.style.left,
                            top: element.style.top,
                            width: element.style.width,
                            height: element.style.height,
                            opacity: element.style.opacity,
                            pointerEvents: element.style.pointerEvents
                        };

                        // Make element clickable but invisible
                        element.style.position = 'absolute';
                        element.style.left = '-9999px';
                        element.style.top = '-9999px';
                        element.style.width = '1px';
                        element.style.height = '1px';
                        element.style.opacity = '0.01';
                        element.style.pointerEvents = 'auto';

                        setTimeout(() => {
                            try {
                                element.click();
                                console.log('Enhanced Safari click completed');
                            } catch (e2) {
                                console.warn('Enhanced Safari click also failed:', e2);

                                // Last resort: create a temporary visible file input
                                const tempInput = document.createElement('input');
                                tempInput.type = 'file';
                                tempInput.accept = element.accept;
                                tempInput.style.position = 'fixed';
                                tempInput.style.top = '50%';
                                tempInput.style.left = '50%';
                                tempInput.style.transform = 'translate(-50%, -50%)';
                                tempInput.style.zIndex = '10000';

                                tempInput.onchange = (e) => {
                                    // Copy files to original input
                                    if (e.target.files && e.target.files.length > 0) {
                                        const dt = new DataTransfer();
                                        for (let file of e.target.files) {
                                            dt.items.add(file);
                                        }
                                        element.files = dt.files;

                                        // Trigger change event on original input
                                        const changeEvent = new Event('change', { bubbles: true });
                                        element.dispatchEvent(changeEvent);
                                    }
                                    document.body.removeChild(tempInput);
                                };

                                document.body.appendChild(tempInput);
                                tempInput.click();
                                console.log('Fallback visible file input created for Safari');
                            }

                            // Restore original styles
                            setTimeout(() => {
                                Object.keys(originalStyles).forEach(key => {
                                    if (originalStyles[key] !== undefined) {
                                        element.style[key] = originalStyles[key];
                                    }
                                });
                            }, 50);
                        }, 10);
                    }
                } else {
                    console.log('Non-Safari browser - using standard click');
                    // Standard click for other browsers
                    element.click();
                }
            } else {
                console.log('Invalid element or not a file input:', element);
            }
        } catch (e) {
            console.warn('triggerFileInput failed:', e);
            // Fallback: try standard click anyway
            if (element && typeof element.click === 'function') {
                console.log('Attempting fallback click...');
                element.click();
            }
        }
    };

    window.addClass = (selector, className) => {
        try {
            const element = document.querySelector('.' + selector);
            if (element) {
                element.classList.add(className);
                console.log(`Added class '${className}' to element with selector '.${selector}'`);
            } else {
                console.warn(`Element with selector '.${selector}' not found`);
            }
        } catch (e) {
            console.warn('addClass failed:', e);
        }
    };

    window.removeClass = (selector, className) => {
        try {
            const element = document.querySelector('.' + selector);
            if (element) {
                element.classList.remove(className);
                console.log(`Removed class '${className}' from element with selector '.${selector}'`);
            } else {
                console.warn(`Element with selector '.${selector}' not found`);
            }
        } catch (e) {
            console.warn('removeClass failed:', e);
        }
    };
</script>
