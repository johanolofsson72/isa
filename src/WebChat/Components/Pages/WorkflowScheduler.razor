    private async Task PauseResumeWorkflow(WorkflowScheduleInfo workflow)
    {
        try
        {
            await SafeJSLog($"PauseResumeWorkflow: {(workflow.Enabled ? "Pausing" : "Resuming")} workflow {workflow.Id}");

            if (workflow.IsQuartzManaged)
            {
                // Use Quartz.NET API
                var action = workflow.Enabled ? "pause" : "resume";
                var response = await Http.PostAsync($"https://localhost:7042/api/workflows/{workflow.Id}/{action}", null);

                if (response.IsSuccessStatusCode)
                {
                    await JS.InvokeVoidAsync("alert", $"Workflow '{workflow.Name}' {action}d successfully!");
                    await LoadSchedules(); // Refresh to show updated status
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", $"Failed to {action} workflow: {response.StatusCode}");
                }
            }
            else
            {
                // Use legacy API
                var update = new WorkflowScheduleUpdateModel
                {
                    Schedule = workflow.Schedule,
                    Enabled = !workflow.Enabled
                };

                var success = await WorkflowService.UpdateWorkflowScheduleAsync(workflow.Id, update);
                if (success)
                {
                    await JS.InvokeVoidAsync("alert", $"Workflow '{workflow.Name}' {(workflow.Enabled ? "disabled" : "enabled")} successfully!");
                    await LoadSchedules();
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", "Failed to update workflow status");
