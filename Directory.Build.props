<Project>
  <PropertyGroup>
    <!-- Common project properties -->
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Company and product information -->
    <Product>AccountingAgent - Isa</Product>
    <Company>AccountingAgent</Company>
    <Authors>AccountingAgent Team</Authors>
    <Copyright>Copyright © AccountingAgent 2025</Copyright>
    <Description>Bookkeeping and accounting applications</Description>

    <!-- Build configuration (strict) -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <WarningsAsErrors />
    <NoWarn>CS1591;NU1902;NU1903</NoWarn>
    <!-- CS1591: Missing XML comment. NU1902/NU1903: pre-existing transitive package vulnerabilities -->
    <!-- (MailKit, MimeKit, Kiota, OpenTelemetry). Track separately, don't block build. -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Version information -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>preview</VersionSuffix>
  </PropertyGroup>

  <!-- Relax nullable init warnings for test projects only -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <NoWarn>$(NoWarn);CS8618</NoWarn>
  </PropertyGroup>
</Project>