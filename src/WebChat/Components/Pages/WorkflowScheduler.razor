    /// <summary>
    /// Tvingar fram en uppdatering av schemalagda arbetsflöden och UI-renderingen
    /// </summary>
    private async Task ForceManualRefresh()
    {
        try
        {
            errorMessage = null;
            isLoading = true;
            await InvokeAsync(StateHasChanged);

            await SafeJSLog("ForceManualRefresh: Starting forced refresh...");

            // Töm aktuell lista för att säkerställa en ren start
            schedules.Clear();
            await InvokeAsync(StateHasChanged);

            // Hämta data direkt från API:et
            var result = await WorkflowService.GetScheduledWorkflowsAsync();
            await SafeJSLog($"ForceManualRefresh: Got {result?.Count ?? 0} scheduled workflows from API");

            if (result != null && result.Count > 0)
            {
                // Kopiera till den lokala listan
                schedules = result.Select(s => new WorkflowScheduleInfo
                {
                    Id = s.Id,
                    Name = s.Name,
                    Description = s.Description ?? "Ingen beskrivning",
                    Schedule = s.Schedule,
                    Enabled = s.Enabled,
                    LastExecuted = s.LastExecuted,
                    NextExecutionTime = s.NextExecutionTime
                }).ToList();

                await SafeJSLog($"ForceManualRefresh: Added {schedules.Count} items to local list");

                // Logga varje schema för felsökning
                foreach (var s in schedules)
                {
                    await SafeJSLog($"Schedule: {s.Id} - {s.Name} - {s.Schedule} - {s.Description}");
                }
            }
            else
            {
                // Lägg till ett testarbetsflöde manuellt om API:et inte returnerar något
                await SafeJSLog("ForceManualRefresh: No workflows returned, adding test workflow");

                schedules.Add(new WorkflowScheduleInfo
                {
                    Id = "test-workflow-manual",
                    Name = "Manuellt tillagt testschema",
                    Description = "Detta är ett test-schema skapat direkt i UI:t",
                    Schedule = "0 12 * * *",
                    Enabled = true,
                    NextExecutionTime = DateTime.Now.AddHours(12)
                });

                await SafeJSLog("ForceManualRefresh: Added test workflow to schedules list");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Fel vid tvingad uppdatering: {ex.Message}";
            await SafeJSError($"ForceManualRefresh error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
            await SafeJSLog("ForceManualRefresh: Completed");
        }
    }

