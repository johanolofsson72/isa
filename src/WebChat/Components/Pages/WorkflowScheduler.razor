@page "/workflows/schedules"
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text
@using Microsoft.JSInterop
@using WebChat.Services

@inject IJSRuntime JS
@inject WorkflowService WorkflowService
@inject HttpClient Http
@inject IConfiguration Configuration


<div class="d-flex gap-2 mb-3">
    <a class="btn btn-outline-secondary" href="@CrystalQuartzUrl" target="_blank" rel="noopener noreferrer">
        <i class="bi bi-speedometer2 me-1"></i>Monitor
    </a>
    <a class="btn btn-outline-secondary" href="@QuartzAdminUrl" target="_blank" rel="noopener noreferrer">
        <i class="bi bi-gear-wide-connected me-1"></i>Admin
    </a>
</div>

<h3>Schemaläggare</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Fel:</strong> @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Stäng"></button>
    </div>
}

<div class="workflow-scheduler">
    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Laddar...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Välj arbetsflöde</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="workflowSelect" class="form-label">Arbetsflöde</label>
                            <select id="workflowSelect" class="form-select" @bind="selectedWorkflowId" @oninput="OnWorkflowSelected">
                                <option value="">-- Välj ett arbetsflöde --</option>
                                @foreach (var workflow in workflows)
                                {
                                    <option value="@workflow.Id">@workflow.Name</option>
                                }
                            </select>
                        </div>

                        @if (selectedWorkflow != null)
                        {
                            <div class="mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="enableScheduling"
                                           @bind="isSchedulingEnabled">
                                    <label class="form-check-label" for="enableScheduling">
                                        Aktivera schemaläggning
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @if (selectedWorkflow != null && isSchedulingEnabled)
            {
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Schemakonfiguration</h5>
                        </div>
                        <div class="card-body">
                            <!-- Schedule Format Selection -->
                            <div class="mb-3">
                                <label class="form-label">Schemaformat</label>
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" class="btn-check" name="scheduleFormat" id="humanReadable"
                                           @onchange="() => SetScheduleFormat(true)" checked="@useHumanReadableFormat">
                                    <label class="btn btn-outline-primary" for="humanReadable">
                                        <i class="bi bi-chat-text"></i> Läsbart format
                                    </label>

                                    <input type="radio" class="btn-check" name="scheduleFormat" id="cronFormat"
                                           @onchange="() => SetScheduleFormat(false)" checked="@(!useHumanReadableFormat)">
                                    <label class="btn btn-outline-primary" for="cronFormat">
                                        <i class="bi bi-code"></i> CRON-uttryck
                                    </label>
                                </div>
                            </div>

                            <!-- Human-Readable Schedule Input -->
                            @if (useHumanReadableFormat)
                            {
                                <div class="mb-3">
                                    <label for="humanSchedule" class="form-label">Schema</label>
                                    <input type="text" class="form-control" id="humanSchedule"
                                           @bind="humanScheduleExpression"
                                           @oninput="OnScheduleInputChanged"
                                           placeholder="t.ex. 'daily at 9am', 'every monday at 2pm'">
                                    <div class="form-text">
                                        <small class="text-muted">
                                            Exempel: "hourly", "daily at 9am", "every monday at 2pm", "weekly"
                                        </small>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- CRON Expression Input -->
                                <div class="mb-3">
                                    <label for="cronExpression" class="form-label">CRON-uttryck</label>
                                    <input type="text" class="form-control" id="cronExpression"
                                           @bind="cronExpression"
                                           @oninput="OnScheduleInputChanged"
                                           placeholder="t.ex. '0 9 * * 1-5' eller '*/5 * * * *'">
                                    <div class="form-text">
                                        <small class="text-muted">
                                            Format: sekund minut timme dag månad veckodag (eller 5-fält utan sekund)
                                        </small>
                                    </div>
                                </div>
                            }

                            <!-- Schedule Validation and Description -->
                            <div class="mb-3">
                                @if (!string.IsNullOrEmpty(scheduleValidationMessage))
                                {
                                    <div class="alert @(scheduleIsValid ? "alert-success" : "alert-danger") py-2">
                                        <i class="bi @(scheduleIsValid ? "bi-check-circle" : "bi-exclamation-triangle")"></i>
                                        @scheduleValidationMessage
                                        @if (!string.IsNullOrEmpty(scheduleDescription))
                                        {
                                            <br><small>@scheduleDescription</small>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Advanced Schedule Settings -->
                            <div class="mb-3">
                                <button class="btn btn-outline-secondary btn-sm" type="button"
                                        @onclick="ToggleAdvancedSettings">
                                    <i class="bi @(showAdvancedSettings ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                    Avancerade inställningar
                                </button>
                            </div>

                            @if (showAdvancedSettings)
                            {
                                <div class="card mb-3">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <label for="timezone" class="form-label">Tidszon</label>
                                                <select class="form-select" id="timezone" @bind="selectedTimezone">
                                                    <option value="Europe/Stockholm">Europe/Stockholm (Standard)</option>
                                                    <option value="UTC">UTC</option>
                                                    <option value="Europe/London">Europe/London</option>
                                                    <option value="America/New_York">America/New_York</option>
                                                    <option value="America/Los_Angeles">America/Los_Angeles</option>
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="misfireHandling" class="form-label">Misfire-hantering</label>
                                                <select class="form-select" id="misfireHandling" @bind="selectedMisfireHandling">
                                                    <option value="Skip">Hoppa över - Vänta på nästa schemalagda tid</option>
                                                    <option value="RunImmediately">Kör omedelbart - Utför missad körning så snart som möjligt</option>
                                                    <option value="RunOnNextSchedule">Kör vid nästa schema - Vänta på nästa schemalagda tid</option>
                                                    <option value="RunImmediatelyAndContinue">Kör omedelbart och fortsätt - Kör nu och fortsätt med normalt schema</option>
                                                </select>
                                                <div class="form-text">
                                                    <small class="text-muted">
                                                        Vad som ska hända om en schemalagd körning missas på grund av systemavbrott
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mt-3">
                                            <label for="scheduleDescription" class="form-label">Beskrivning (valfritt)</label>
                                            <input type="text" class="form-control" id="scheduleDescription"
                                                   @bind="customScheduleDescription"
                                                   placeholder="Anpassad beskrivning av schemat">
                                        </div>

                                        <!-- Workflow Navigation Settings -->
                                        <div class="mt-4">
                                            <h6 class="text-primary mb-3">
                                                <i class="bi bi-diagram-3"></i> Arbetsflödesnavigering
                                            </h6>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <label for="onSuccessStep" class="form-label">Vid framgång (OnSuccess)</label>
                                                    <input type="text" class="form-control" id="onSuccessStep"
                                                           @bind="onSuccessStep" @oninput="OnNavigationStepChanged"
                                                           placeholder="Steg-ID att köra vid framgång">
                                                    <div class="form-text">
                                                        <small class="text-muted">
                                                            Steg att köra när arbetsflödet slutförs framgångsrikt
                                                        </small>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(onSuccessValidation))
                                                    {
                                                        <div class="text-danger small mt-1">
                                                            <i class="bi bi-exclamation-triangle"></i> @onSuccessValidation
                                                        </div>
                                                    }
                                                </div>
                                                <div class="col-md-6">
                                                    <label for="onErrorStep" class="form-label">Vid fel (OnError)</label>
                                                    <input type="text" class="form-control" id="onErrorStep"
                                                           @bind="onErrorStep" @oninput="OnNavigationStepChanged"
                                                           placeholder="Steg-ID att köra vid fel">
                                                    <div class="form-text">
                                                        <small class="text-muted">
                                                            Steg att köra när arbetsflödet misslyckas eller får fel
                                                        </small>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(onErrorValidation))
                                                    {
                                                        <div class="text-danger small mt-1">
                                                            <i class="bi bi-exclamation-triangle"></i> @onErrorValidation
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            @if (availableSteps.Any())
                                            {
                                                <div class="mt-2">
                                                    <small class="text-info">
                                                        <i class="bi bi-info-circle"></i> Tillgängliga steg: @string.Join(", ", availableSteps)
                                                    </small>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="enableScheduling"
                                           @bind="isSchedulingEnabled">
                                    <label class="form-check-label" for="enableScheduling">
                                        Aktivera schemaläggning
                                    </label>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Vanliga scheman</label>
                                @if (useHumanReadableFormat)
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                                @onclick='() => SetHumanSchedule("daily at 9am")'>
                                            Dagligen 09:00
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                                @onclick='() => SetHumanSchedule("every monday at 2pm")'>
                                            Måndagar 14:00
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                                @onclick='() => SetHumanSchedule("weekly")'>
                                            Veckovis
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                                @onclick='() => SetHumanSchedule("hourly")'>
                                            Varje timme
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                                @onclick='() => SetHumanSchedule("monthly")'>
                                            Månadsvis
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => SetCronExpression(@"0 9 * * *"))">
                                            Dagligen kl 09:00
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => SetCronExpression(@"0 9 * * 1-5"))">
                                            Vardagar kl 09:00
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => SetCronExpression(@"0 */2 * * *"))">
                                            Varannan timme
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => SetCronExpression(@"0 0 1 * *"))">
                                            Första dagen i månaden vid midnatt
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => SetCronExpression(@"0 9 */2 * *"))">
                                            Varannan dag kl 09:00
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (selectedWorkflow != null)
        {
            <div class="row">
                <div class="col-md-12 mb-4">
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Arbetsflödesdetaljer</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <strong>Namn:</strong> @selectedWorkflow.Name
                            </div>
                            <div class="mb-3">
                                <strong>Beskrivning:</strong> @selectedWorkflow.Description
                            </div>
                            @if (selectedWorkflow.LastExecuted.HasValue)
                            {
                                <div class="mb-3">
                                    <strong>Senast körd:</strong> @selectedWorkflow.LastExecuted.Value.ToString("yyyy-MM-dd HH:mm:ss")
                                </div>
                            }
                            @if (selectedWorkflow.NextExecutionTime.HasValue)
                            {
                                <div class="mb-3">
                                    <strong>Nästa körning:</strong> @selectedWorkflow.NextExecutionTime.Value.ToString("yyyy-MM-dd HH:mm:ss")
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Job History and Monitoring Tabs -->
            <div class="row">
                <div class="col-md-12 mb-4">
                    <div class="card">
                        <div class="card-header bg-info text-white">
                            <ul class="nav nav-tabs card-header-tabs" id="monitoringTabs" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active" id="history-tab" data-bs-toggle="tab"
                                            data-bs-target="#history" type="button" role="tab"
                                            aria-controls="history" aria-selected="true"
                                            @onclick="() => LoadJobHistory()">
                                        <i class="bi bi-clock-history"></i> Körningshistorik
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="statistics-tab" data-bs-toggle="tab"
                                            data-bs-target="#statistics" type="button" role="tab"
                                            aria-controls="statistics" aria-selected="false"
                                            @onclick="() => LoadJobStatistics()">
                                        <i class="bi bi-graph-up"></i> Statistik
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="performance-tab" data-bs-toggle="tab"
                                            data-bs-target="#performance" type="button" role="tab"
                                            aria-controls="performance" aria-selected="false"
                                            @onclick="() => LoadPerformanceMetrics()">
                                        <i class="bi bi-speedometer2"></i> Prestanda
                                    </button>
                                </li>
                            </ul>
                        </div>
                        <div class="card-body">
                            <div class="tab-content" id="monitoringTabsContent">
                                <!-- Job History Tab -->
                                <div class="tab-pane fade show active" id="history" role="tabpanel" aria-labelledby="history-tab">
                                    @if (isLoadingHistory)
                                    {
                                        <div class="d-flex justify-content-center my-3">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Laddar historik...</span>
                                            </div>
                                        </div>
                                    }
                                    else if (jobExecutions.Any())
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-striped table-hover">
                                                <thead>
                                                    <tr>
                                                        <th>Tid</th>
                                                        <th>Status</th>
                                                        <th>Varaktighet</th>
                                                        <th>Felmeddelande</th>
                                                        <th>Åtgärder</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var execution in jobExecutions.Take(20))
                                                    {
                                                        <tr>
                                                            <td>
                                                                <small>@execution.StartTime.ToString("yyyy-MM-dd HH:mm:ss")</small>
                                                            </td>
                                                            <td>
                                                                @if (execution.Status == "Success")
                                                                {
                                                                    <span class="badge bg-success">
                                                                        <i class="bi bi-check-circle"></i> Framgång
                                                                    </span>
                                                                }
                                                                else if (execution.Status == "Failed")
                                                                {
                                                                    <span class="badge bg-danger">
                                                                        <i class="bi bi-x-circle"></i> Misslyckad
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-warning">
                                                                        <i class="bi bi-clock"></i> @execution.Status
                                                                    </span>
                                                                }
                                                            </td>
                                                            <td>
                                                                <small>@execution.Duration ms</small>
                                                            </td>
                                                            <td>
                                                                @if (!string.IsNullOrEmpty(execution.ErrorMessage))
                                                                {
                                                                    <small class="text-danger">@execution.ErrorMessage</small>
                                                                }
                                                                else
                                                                {
                                                                    <small class="text-muted">-</small>
                                                                }
                                                            </td>
                                                            <td>
                                                                <button class="btn btn-sm btn-outline-info"
                                                                        @onclick="() => ShowExecutionDetails(execution.Id)">
                                                                    <i class="bi bi-eye"></i>
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                            <small class="text-muted">Visar senaste 20 körningarna</small>
                                            <button class="btn btn-sm btn-outline-primary" @onclick="ExportJobHistory">
                                                <i class="bi bi-download"></i> Exportera
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-info">
                                            <i class="bi bi-info-circle"></i> Ingen körningshistorik hittades för detta arbetsflöde.
                                        </div>
                                    }
                                </div>

                                <!-- Statistics Tab -->
                                <div class="tab-pane fade" id="statistics" role="tabpanel" aria-labelledby="statistics-tab">
                                    @if (jobStatistics != null)
                                    {
                                        <div class="row">
                                            <div class="col-md-3">
                                                <div class="card bg-primary text-white">
                                                    <div class="card-body text-center">
                                                        <h4>@jobStatistics.TotalExecutions</h4>
                                                        <small>Totala körningar</small>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="card bg-success text-white">
                                                    <div class="card-body text-center">
                                                        <h4>@jobStatistics.SuccessRate.ToString("F1")%</h4>
                                                        <small>Framgångsgrad</small>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="card bg-warning text-white">
                                                    <div class="card-body text-center">
                                                        <h4>@jobStatistics.AverageExecutionTime.ToString("F0") ms</h4>
                                                        <small>Genomsnittlig tid</small>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="card @(jobStatistics.HealthStatus == "Healthy" ? "bg-success" : jobStatistics.HealthStatus == "Warning" ? "bg-warning" : "bg-danger") text-white">
                                                    <div class="card-body text-center">
                                                        <h4>@jobStatistics.HealthStatus</h4>
                                                        <small>Hälsostatus</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mt-3">
                                            <div class="col-md-6">
                                                <div class="card">
                                                    <div class="card-header">
                                                        <h6 class="mb-0">Körningsdetaljer</h6>
                                                    </div>
                                                    <div class="card-body">
                                                        <p><strong>Senaste körning:</strong> @jobStatistics.LastExecutionTime?.ToString("yyyy-MM-dd HH:mm:ss")</p>
                                                        <p><strong>Senaste status:</strong>
                                                            <span class="badge @(jobStatistics.LastExecutionStatus == "Success" ? "bg-success" : "bg-danger")">
                                                                @jobStatistics.LastExecutionStatus
                                                            </span>
                                                        </p>
                                                        <p><strong>Min/Max tid:</strong> @jobStatistics.MinExecutionTime ms / @jobStatistics.MaxExecutionTime ms</p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="card">
                                                    <div class="card-header">
                                                        <h6 class="mb-0">Aktivitet</h6>
                                                    </div>
                                                    <div class="card-body">
                                                        <p><strong>Senaste aktivitet:</strong> @(jobStatistics.HasRecentActivity ? "Ja" : "Nej")</p>
                                                        <p><strong>Misslyckanden:</strong> @(jobStatistics.TotalExecutions - (int)(jobStatistics.TotalExecutions * jobStatistics.SuccessRate / 100))</p>
                                                        <p><strong>Framgångar:</strong> @((int)(jobStatistics.TotalExecutions * jobStatistics.SuccessRate / 100))</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-info">
                                            <i class="bi bi-info-circle"></i> Ingen statistik tillgänglig. Klicka för att ladda data.
                                        </div>
                                    }
                                </div>

                                <!-- Performance Tab -->
                                <div class="tab-pane fade" id="performance" role="tabpanel" aria-labelledby="performance-tab">
                                    <div class="alert alert-info">
                                        <i class="bi bi-info-circle"></i> Prestandamätningar kommer snart. Denna flik kommer att visa detaljerade prestandagrafer och trender.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

            <div class="row">
                <div class="col-md-12 text-center">
                    <button type="button" class="btn btn-primary" @onclick="SaveSchedule">
                        <i class="bi bi-save"></i> Spara schema
                    </button>
                    <button type="button" class="btn btn-outline-secondary ms-2" @onclick="ClearSelection">
                        <i class="bi bi-x-circle"></i> Avbryt
                    </button>
                </div>
            </div>
        }

        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Schemalagda arbetsflöden</h5>
                        <button type="button" class="btn btn-sm btn-light" @onclick="LoadSchedules">
                            <i class="bi bi-arrow-clockwise"></i> Uppdatera
                        </button>
                    </div>
                    <div class="card-body">
                        @if (schedules.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>Namn</th>
                                            <th>Schema</th>
                                            <th>Status</th>
                                            <th>Prestanda</th>
                                            <th>Senast körd</th>
                                            <th>Nästa körning</th>
                                            <th>Åtgärder</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var schedule in schedules)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@schedule.Name</strong>
                                                    @if (!string.IsNullOrEmpty(schedule.Description))
                                                    {
                                                        <br><small class="text-muted">@schedule.Description</small>
                                                    }
                                                </td>
                                                <td>
                                                    <code class="bg-light px-2 py-1 rounded">@schedule.Schedule</code>
                                                    <br><small class="text-muted">@GetCronDescription(schedule.Schedule)</small>
                                                </td>
                                                <td>
                                                    @if (schedule.IsQuartzManaged)
                                                    {
                                                        <span class="badge bg-primary mb-1">
                                                            <i class="bi bi-gear"></i> Quartz.NET
                                                        </span>
                                                        <br>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning mb-1">
