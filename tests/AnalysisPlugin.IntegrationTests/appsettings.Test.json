{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AnalysisPlugin": {
    "DatabaseConnectionString": "",
    "EnableCaching": true,
    "CacheExpirationMinutes": 30,
    "MaxConcurrentReports": 3,
    "ReportTimeoutMinutes": 10,
    "EnableEmailDelivery": false,
    "EnableReportArchiving": true,
    "ArchiveRetentionDays": 30,
    "EnablePerformanceOptimization": true,
    "MaxHistoricalYears": 5,
    "DefaultLanguage": "sv",
    "EnableMLForecasting": true,
    "ForecastHorizonMonths": 12,
    "EnableAdvancedFiltering": true,
    "EnableMultiSheetReports": true,
    "EnableExecutiveReports": true,
    "EnableScheduledReports": true,
    "EnableAIOrchestration": true,
    "EnableErrorRecovery": true,
    "EnableAdvancedAnalytics": true,
    "MaxReportSizeMB": 50,
    "SIE4Processing": {
      "ValidateFormat": true,
      "EnableDataCleaning": true,
      "MaxTransactions": 100000
    },
    "ExcelGeneration": {
      "EnableAdvancedStyling": true,
      "SwedishLocalization": {
        "CurrencyFormat": "#,##0.00 \"kr\"",
        "DateFormat": "yyyy-MM-dd"
      }
    },
    "AIOrchestration": {
      "EnableNaturalLanguageProcessing": true,
      "SupportedLanguages": [
        "sv",
        "en"
      ],
      "EnableContextualReports": true
    }
  },
  "Fortnox": {
    "ApiUrl": "https://api.fortnox.se/3",
    "ClientId": "test-client-id",
    "ClientSecret": "",
    "RedirectUri": "http://localhost:5000/callback",
    "Scopes": "bookkeeping"
  },
  "TestData": {
    "UseMockData": true,
    "MockDataPath": "TestData",
    "EnableFortnoxIntegration": false,
    "TestCompanyName": "Demo Ekonomi AB",
    "TestFinancialYear": 2024,
    "UseRealSIE4Data": true,
    "SIE4DataPath": "./SIE4",
    "GenerateTestReports": true,
    "TestReportPath": "./TestResults"
  }
}
